{
  "name": "magento-flipick-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --use-system-ca server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "regression": "node tests/regression/run.js",
    "regression:soak": "node tests/regression/run.js soak",
    "db:bootstrap": "node scripts/db/provision.js",
    "db:provision": "node scripts/db/provision.js",
    "db:migrate": "node scripts/db/migrate.js",
    "db:status": "node scripts/db/status.js",
    "db:verify": "node scripts/db/verify.js",
    "db:manifest": "node scripts/db/manifest.js",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm --omit dev --output-format JSON --output-file sbom.cdx.json",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0"
  }
}
