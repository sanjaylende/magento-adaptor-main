# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Magento connection details are NOT configured here any more: each merchant's extension registers its own installation
# (store URL + integration token) with this service.

# --- Service ---
PORT=4200
# Public address of this service (payment return URLs, invoice links). Must be https:// when deployed.
PUBLIC_BASE_URL=http://localhost:4200
NODE_ENV=development

# --- Database (PostgreSQL) ---
# The running service connects as a role WITHOUT BYPASSRLS so row-level security applies; migrations use the owner role.
# Local development: `docker compose up -d db` starts a matching PostgreSQL on port 5434 (these are its defaults).
DATABASE_URL=postgresql://adapter_app:adapter_app_local@127.0.0.1:5434/magento_adapter
DATABASE_ADMIN_URL=postgresql://adapter_owner:adapter_owner_local@127.0.0.1:5434/magento_adapter
DB_SSL=disable

# --- Secrets ---
# 32 random bytes as 64 hex characters. Encrypts installation secrets and Magento tokens, signs browser sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   Losing it invalidates stored secrets.
ADAPTER_SECRET_KEY=

# First staff account for /admin, created only when there are no staff accounts yet.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Payments ---
# mock = built-in test gateway (development, automated tests). icici = ICICI Bank payment gateway.
PAYMENT_GATEWAY=mock
ICICI_PG_BASE_URL=https://pgpayuat.icicibank.com
ICICI_PG_MERCHANT_ID=
ICICI_PG_AGGREGATOR_ID=
ICICI_PG_SECRET_KEY=

# --- Billing ---
BILLING_GRACE_DAYS=3
BILLING_REMINDER_DAYS=5
# PLACEHOLDERS: confirm with your accountant / set the real rate before launch.
GST_RATE_BP=1800
INR_PER_USD=83
SELLER_NAME=Flipick
SELLER_ADDRESS=
SELLER_GST_NUMBER=

# --- Flipick video engine (shared by all merchants) ---
FLIPICK_SPONSORED_ADS_BASE_URL=
FLIPICK_VVP_API_KEY=
FLIPICK_SPONSORED_ADS_API_KEY=
FLIPICK_TENANT_ID=
RETAILER_NAME=
FLIPICK_VIDEO_ENGINE_BASE_URL=
FLIPICK_VIDEO_ENGINE_API_KEY=
