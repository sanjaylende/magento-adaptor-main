# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Magento connection details are NOT configured here any more: each merchant's extension registers its own installation
# (store URL + integration token) with this service.

# --- Service ---
PORT=4200
# Public address of this service (payment return URLs, invoice links). Must be https:// when deployed.
PUBLIC_BASE_URL=http://localhost:4200
NODE_ENV=development
# LOG_LEVEL debug|info|warn|error; LOG_FORMAT text|json (json for production log shippers). Secrets are redacted either way.
LOG_LEVEL=info
LOG_FORMAT=text
# Log files: logs/app.log (everything) and logs/error.log (warnings and errors). Every day at LOG_ROTATE_AT (server local time) and whenever
# a file passes LOG_MAX_BYTES (10 MB) it is zipped (app-2026-10-08.zip, app-2026-10-08-153012.zip) and a new file is started.
LOG_TO_FILE=true
LOG_DIR=./logs
LOG_MAX_BYTES=10485760
LOG_ROTATE_AT=00:05
# Delete archives older than this many days (0 = keep everything).
LOG_RETENTION_DAYS=0

# --- Database (PostgreSQL) ---
# The running service connects as a role WITHOUT BYPASSRLS so row-level security applies; migrations use the owner role.
# The adapter's data is its OWN SCHEMA (DB_SCHEMA, default magento_adapter) inside the shared PostgreSQL database ltx_1jnl (the same server and
# database the Shopify and WooCommerce adapters use, each in its own schema). Both roles below are dedicated to this adapter and are created
# once by a database administrator:  DATABASE_SUPERUSER_URL=postgresql://<admin>@127.0.0.1:5432/ltx_1jnl npm run db:bootstrap
# (that administrator URL is used only by that one command and by the tests, never by the running service; keep it out of this file).
# Set-up order, the same on local, stage and production:  1) npm run db:bootstrap (once)  2) npm run db:migrate (every deploy)
# 3) npm run db:verify -- --expect-empty-install   See db/README.md. DATABASE_URL = the service role, DATABASE_ADMIN_URL = the owner role
# that runs migrations. Choose a strong, different password for each (a secret manager, never this file).
DATABASE_URL=postgresql://magento_adapter_app:CHANGE-ME@127.0.0.1:5432/ltx_1jnl
DATABASE_ADMIN_URL=postgresql://magento_adapter_owner:CHANGE-ME@127.0.0.1:5432/ltx_1jnl
DB_SCHEMA=magento_adapter
# The service's share of the shared server's connections (the owner role used for migrations adds at most 2 for a moment).
DB_POOL_MAX=8
DB_IDLE_TIMEOUT_MS=30000
# true (default): the service applies pending migrations when it starts (under an advisory lock, so several instances are safe).
# false: a deploy step runs "npm run db:migrate" first and the service only checks that nothing is pending (it refuses to start otherwise).
RUN_MIGRATIONS_ON_START=true
# ROLLBACK to the old single-purpose database (docker compose up -d db, port 5434): DATABASE_URL=postgresql://adapter_app:adapter_app_local@127.0.0.1:5434/magento_adapter,
# DATABASE_ADMIN_URL=postgresql://adapter_owner:adapter_owner_local@127.0.0.1:5434/magento_adapter and DB_SCHEMA=public.
# disable | require (TLS + the server certificate is verified; use this for any remote database) | no-verify (never in production)
DB_SSL=disable
# Path to the CA certificate that signed the database server, when it is not a public CA (managed databases publish theirs).
DB_SSL_CA=

# --- Secrets ---
# 32 random bytes as 64 hex characters. Encrypts installation secrets and Magento tokens, signs browser sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   Losing it invalidates stored secrets.
ADAPTER_SECRET_KEY=

# Staff sign in to /admin with their LTX account: LTX superadmins, and LTX admins of FLIPICK_TENANT_ID. No staff passwords are stored here.
# The sign-in address defaults to FLIPICK_VIDEO_ENGINE_BASE_URL; set this only if LTX's login is served elsewhere.
# ADMIN_AUTH_BASE_URL=

# Staff console sessions. Password checks, lock-out and two-factor are LTX's.
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_HOURS=8

# --- Payments ---
# ICICI Bank payment gateway (the only one). Sandbox (UAT) address below; production uses https://pgpay.icicibank.com
ICICI_PG_BASE_URL=https://pgpayuat.icicibank.com
ICICI_PG_MERCHANT_ID=
ICICI_PG_AGGREGATOR_ID=
ICICI_PG_SECRET_KEY=
# Source addresses of ICICI's Payment Advice webhook (comma separated, CIDR allowed). Empty = not restricted (signature still checked).
ICICI_CALLBACK_ALLOWED_IPS=

# --- Hardening ---
# Shared secret the video engine sends in the X-Webhook-Secret header of its callback. Empty = callback accepted unsigned.
VIDEO_ENGINE_WEBHOOK_SECRET=
# Extra host names this server may call besides the configured video engine hosts (comma separated).
OUTBOUND_ALLOWED_HOSTS=
# Where vulnerability reports go (served at /.well-known/security.txt).
SECURITY_CONTACT=mailto:security@flipick.com
# Monitoring script limits (scripts/check-health.js)
HEALTH_PENDING_MINUTES=30
HEALTH_REFUND_DAYS=3

# --- Billing ---
# How often (ms) the bank may be asked about one order while the merchant's page polls it. Default 10000; 0 asks on every poll.
# BILLING_ORDER_CHECK_MIN_INTERVAL_MS=10000
BILLING_GRACE_DAYS=3
BILLING_REMINDER_DAYS=5
# PLACEHOLDERS: confirm with your accountant / set the real rate before launch.
GST_RATE_BP=1800
INR_PER_USD=83
SELLER_NAME=Flipick
SELLER_ADDRESS=
SELLER_GST_NUMBER=

# --- Flipick video engine (shared by all merchants) ---
FLIPICK_SPONSORED_ADS_BASE_URL=
FLIPICK_VVP_API_KEY=
FLIPICK_TENANT_ID=
RETAILER_NAME=
# Optional: product attribute whose option labels name a product's category (default product_type; a store can override it).
# MAGENTO_CATEGORY_ATTRIBUTE_CODE=product_type
FLIPICK_VIDEO_ENGINE_BASE_URL=
FLIPICK_VIDEO_ENGINE_API_KEY=

# Shared secret for server-to-server calls from LTX (X-Internal-Secret header), e.g. GET /internal/magento-token/:shop. Same value on both
# sides; empty = those routes refuse everyone.
INTERNAL_API_SECRET=
